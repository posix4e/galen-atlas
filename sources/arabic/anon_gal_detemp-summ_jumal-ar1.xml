	<text xml:lang="ar" xml:id="anon.gal.detemp-summ.jumal-ar1">
		<body>
			<pb unit="folio" edRef="#A" n="18r"/>
			<pb unit="folio" edRef="#B" n="42v"/>
			<pb unit="folio" edRef="#E" n="56v"/>
			<div1 type="sentence" n="0">
			<head>
				<anchor xml:id="appcrit1begin"/>
				جمل ما في المقالة الأولی
				<anchor xml:id="appcrit1end"/>
				<anchor xml:id="appcrit2begin"/>
				من كتاب جالينوس في المزاج ترجمه
				<anchor xml:id="appcrit3begin"/>
				حنين
				<anchor xml:id="appcrit2end"/>
			</head>
			<div1 type="sentence" n="1">
				الجملة
				<anchor xml:id="appcrit4begin"/>
				الأولی يذكر فيها
				<anchor xml:id="appcrit4end"/>
				أنّ أصناف المزاج تسعة
			</div1>
			<div1 type="sentence" n="2">
				<anchor xml:id="appcrit5begin"/>
				والثانية أنّه ينبغي أن يقال إنّ أفضلها هو المعتدل فيما بين الحارّ والبارد والرطب
				<anchor xml:id="appcrit5end"/>
				واليابس
			</div1>
			<div1 type="sentence" n="3">
				والثالثة أنّ من هذه الأصناف التسعة
				<anchor xml:id="appcrit6begin"/>
				واحداً معتدلاً
				<anchor xml:id="appcrit6end"/>
				<anchor xml:id="appcrit7begin"/>
				و
				<anchor xml:id="appcrit7end"/>
				أربعة
				<anchor xml:id="appcrit8begin"/>
				بسيطة
				<anchor xml:id="appcrit8end"/>
				رديئة
				<anchor xml:id="appcrit9begin"/>
				وهي
				<anchor xml:id="appcrit9end"/>
				الحارّ والبارد والرطب واليابس
				<anchor xml:id="appcrit10begin"/>
				ومنها أربعة
				<anchor xml:id="appcrit10end"/>
				مركّبة
				<anchor xml:id="appcrit11begin"/>
				رديئة
				<anchor xml:id="appcrit11end"/>
				<anchor xml:id="appcrit12end"/>
				أحدها المزاج الحارّ اليابس والثاني الحارّ الرطب والثالث البارد اليابس والرابع البارد الرطب
			</div1>
			<div1 type="sentence" n="4">
				والرابعة كيف قال بعض الأطبّاء إنّ المزاج المعتدل هو
				<anchor xml:id="appcrit13begin"/>
				المزاج
				<anchor xml:id="appcrit13end"/>
				الحارّ الرطب
			</div1>
			<div1 type="sentence" n="5">
				والخامسة في تعرّف مزاج الحيوان مطلقاً
			</div1>
			<div1 type="sentence" n="6">
				والسادسة في تعرّف مزاج الأعضاء مطلقاً
			</div1>
			<div1 type="sentence" n="7">
				والسابعة في
				<anchor xml:id="appcrit14begin"/>
				تعرّف
				<anchor xml:id="appcrit14end"/>
				مزاج الناس مطلقاً
			</div1>
			<div1 type="sentence" n="8">
				<anchor xml:id="appcrit15begin"/>
				والثامنة يخبر فيها بأعلام أمزجة تؤخذ من أعضاء الناس
				<anchor xml:id="appcrit15end"/>
			</div1>
			</div1>
		</body>
